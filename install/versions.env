# shellcheck disable=SC2034  # variables consommées par les scripts qui sourcent ce fichier
# ==============================================================================
# versions.env — Versions épinglées des outils installés depuis GitHub/releases
# ------------------------------------------------------------------------------
# Sourcé par install-kali.sh, install-ubuntu.sh et update-tools.sh.
# Un seul endroit à modifier quand une nouvelle release sort.
# Vérifiez les dernières versions puis mettez à jour ici, ou lancez :
#   ./install/update-tools.sh --check    (compare aux dernières releases GitHub)
# ==============================================================================

# rustscan — https://github.com/RustScan/RustScan/releases
# NB : épinglé à 2.1.1 = DERNIÈRE release fournissant un paquet .deb. Les versions
# ≥ 2.2 ne publient plus de .deb (seulement des .zip), ce qui casserait le script.
# Sur Kali, rustscan vient de toute façon d'apt. Ne pas bumper sans adapter l'install.
RUSTSCAN_VERSION="2.1.1"

# ligolo-ng — https://github.com/nicocha30/ligolo-ng/releases
LIGOLO_VERSION="0.9.1"

# chisel — https://github.com/jpillora/chisel/releases
CHISEL_VERSION="1.12.0"

# --- Dépôts git suivis (branche par défaut, pas de version épinglée) ---------
# Listés ici pour update-tools.sh / check-tools.sh ; clonés dans /opt.
GIT_REPOS=(
  "https://github.com/peass-ng/PEASS-ng.git|PEASS-ng"
  "https://github.com/DominicBreuker/pspy.git|pspy"
  "https://github.com/The-Z-Labs/linux-exploit-suggester.git|linux-exploit-suggester"
  "https://github.com/danielmiessler/SecLists.git|SecLists"
  "https://gitlab.com/exploit-database/exploitdb.git|exploitdb"
)
