# shellcheck disable=SC2034  # variables consumed by the scripts that source this file
# ==============================================================================
# versions.env — Pinned versions of tools installed from GitHub/releases
# ------------------------------------------------------------------------------
# Sourced by install-kali.sh, install-ubuntu.sh and update-tools.sh.
# A single place to edit when a new release comes out.
# Check the latest versions then update here, or run:
#   ./install/update-tools.sh --check    (compares to latest GitHub releases)
# ==============================================================================

# rustscan — https://github.com/RustScan/RustScan/releases
# NB: pinned to 2.1.1 = LAST release providing a .deb package. Versions
# ≥ 2.2 no longer publish a .deb (only .zip), which would break the script.
# On Kali, rustscan comes from apt anyway. Do not bump without adapting the install.
RUSTSCAN_VERSION="2.1.1"

# ligolo-ng — https://github.com/nicocha30/ligolo-ng/releases
LIGOLO_VERSION="0.9.1"

# chisel — https://github.com/jpillora/chisel/releases
CHISEL_VERSION="1.12.0"

# --- Tracked git repos (default branch, no pinned version) -------------------
# Listed here for update-tools.sh / check-tools.sh; cloned into /opt.
GIT_REPOS=(
  "https://github.com/peass-ng/PEASS-ng.git|PEASS-ng"
  "https://github.com/DominicBreuker/pspy.git|pspy"
  "https://github.com/The-Z-Labs/linux-exploit-suggester.git|linux-exploit-suggester"
  "https://github.com/danielmiessler/SecLists.git|SecLists"
  "https://gitlab.com/exploit-database/exploitdb.git|exploitdb"
)
