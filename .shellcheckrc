# ShellCheck configuration for CI
# Allows following sourced files (versions.env, lib/common.sh)
external-sources=true
# Disabled checks (deliberate project patterns):
#   SC1091: sourced file not statically analyzable (dynamic path).
#   SC2086: $SUDO is left unquoted ON PURPOSE — it is "" (root) or "sudo".
#           Quoting it would break the command when the variable is empty.
#   SC2059: color codes (constants) in printf format strings —
#           deliberate display pattern, no user input.
disable=SC1091,SC2086,SC2059
