# Configuration ShellCheck pour la CI
# Autorise le suivi des fichiers sourcés (versions.env, lib/common.sh)
external-sources=true
# Checks désactivés (motifs volontaires du projet) :
#   SC1091 : fichier sourcé non analysable statiquement (chemin dynamique).
#   SC2086 : $SUDO est laissé non quoté À DESSEIN — vaut "" (root) ou "sudo".
#            Le quoter casserait la commande quand la variable est vide.
#   SC2059 : codes couleur (constantes) dans les chaînes de format printf —
#            motif d'affichage volontaire, aucune entrée utilisateur.
disable=SC1091,SC2086,SC2059
